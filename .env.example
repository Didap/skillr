DATABASE_URL="postgres://postgres:password@localhost:5432/skillr"

# Auth.js (next-auth v5)
# AUTH_SECRET signs sessions: generate one with `npx auth secret` or `openssl rand -base64 33`.
# The old NEXTAUTH_SECRET / NEXTAUTH_URL names are still read as fallbacks, but AUTH_* wins.
AUTH_SECRET="generate-a-secret-here"
# Public base URL of the app. Optional on Vercel. NEXTAUTH_URL is also read directly by the
# app to build links in emails (matches, bookings), so keep both set to the same value.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google login (OAuth client from Google Cloud Console).
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic link login (Auth.js Resend provider). It reads this variable, not RESEND_API_KEY;
# usually it holds the same key.
AUTH_RESEND_KEY=""

# Pusher Configuration
PUSHER_APP_ID="YOUR_APP_ID"
NEXT_PUBLIC_PUSHER_KEY="YOUR_KEY"
PUSHER_SECRET="YOUR_SECRET"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_preset"

# Resend
RESEND_API_KEY=""
RESEND_AUDIENCE_ID="your_audience_id"
EMAIL_FROM="Skillr <onboarding@resend.dev>"

# Chat moderation: reports from the chat are emailed here (with the last 20 messages).
# Without it reports are only stored in the chat_reports table.
CHAT_MODERATION_EMAIL=

# Google Calendar / Meet Integration
GOOGLE_CLIENT_EMAIL="tuo-service-account@progetto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="LaTuaChiavePrivata"
GOOGLE_CALENDAR_ID="primary"

# Cloudflare Turnstile (Anti-Spam)
# The values below are Cloudflare's always-pass test keys. With TURNSTILE_SECRET_KEY set, login
# and registration require a valid token; leave it empty only for local dev without the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
